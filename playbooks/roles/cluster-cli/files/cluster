class NotificationError(RuntimeError):
  pass


def _empty_notification_registry():
  return {
    'config': {
      'enabled': False,
      'region': '',
      'compartment_id': '',
      'cluster_name': '',
      'cluster_scope_id': '',
      'auth': 'instance_principal',
    },
    'users': {},
  }


def _normalize_notification_registry(registry):
  if not isinstance(registry, dict):
    raise NotificationError('Notification registry must contain a JSON object')

  config = registry.get('config', {})
  users = registry.get('users', {})
  if not isinstance(config, dict) or not isinstance(users, dict):
    raise NotificationError(
      "Notification registry fields 'config' and 'users' must be JSON objects"
    )

  normalized = dict(registry)
  normalized['config'] = dict(config)
  normalized['users'] = dict(users)
  return normalized


def _load_notification_registry(path=None):
  if path is None:
    path = notification_registry_path
  try:
    with open(path, 'r') as registry_file:
      return _normalize_notification_registry(json.load(registry_file))
  except FileNotFoundError:
    return _empty_notification_registry()
  except (OSError, ValueError) as error:
    raise NotificationError(
      'Unable to read notification registry {}: {}'.format(path, error)
    ) from error


def _update_notification_registry(mutator, path=None):
  """Update the runtime registry while retaining its owner, group, and mode."""
  if path is None:
    path = notification_registry_path

  directory = os.path.dirname(path)
  lock_path = path + '.lock'
  try:
    os.makedirs(directory, exist_ok=True)
    with open(lock_path, 'a+') as lock_file:
      fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
      registry = _load_notification_registry(path)
      result = mutator(registry)

      existing_stat = None
      try:
        existing_stat = os.stat(path)
      except FileNotFoundError:
        pass

      file_descriptor, temporary_path = tempfile.mkstemp(
        prefix='.slurm_notification_users.',
        suffix='.tmp',
        dir=directory,
      )
      try:
        with os.fdopen(file_descriptor, 'w') as temporary_file:
          json.dump(registry, temporary_file, indent=2, sort_keys=True)
          temporary_file.write('\n')
          temporary_file.flush()
          os.fsync(temporary_file.fileno())
          if existing_stat is not None:
            os.fchmod(
              temporary_file.fileno(), stat.S_IMODE(existing_stat.st_mode)
            )
            os.fchown(
              temporary_file.fileno(),
              existing_stat.st_uid,
              existing_stat.st_gid,
            )
          else:
            os.fchmod(temporary_file.fileno(), 0o640)
        os.replace(temporary_path, path)
      finally:
        if os.path.exists(temporary_path):
          os.unlink(temporary_path)
      return result
  except NotificationError:
    raise
  except OSError as error:
    raise NotificationError(
      'Unable to update notification registry {}: {}'.format(path, error)
    ) from error


def _notifications_enabled(registry):
  enabled = registry.get('config', {}).get('enabled', False)
  if isinstance(enabled, str):
    return enabled.strip().lower() in ('1', 'true', 'yes', 'on')
  return bool(enabled)


def _validated_notification_config(registry):
  config = dict(registry.get('config', {}))
  missing = [
    field for field in (
      'region', 'compartment_id', 'cluster_name', 'cluster_scope_id'
    ) if not str(config.get(field, '')).strip()
  ]
  if missing:
    raise NotificationError(
      'Notification registry is missing required config: {}'.format(
        ', '.join(missing)
      )
    )

  auth = config.get('auth', 'instance_principal')
  if auth != 'instance_principal':
    raise NotificationError(
      "Unsupported notification auth '{}'; expected instance_principal".format(
        auth
      )
    )
  config['auth'] = auth
  return config


def _validate_email(email):
  if (
    not isinstance(email, str)
    or len(email) > 254
    or email_pattern.fullmatch(email) is None
  ):
    return False
  local_part = email.rsplit('@', 1)[0]
  return (
    not local_part.startswith('.')
    and not local_part.endswith('.')
    and '..' not in local_part
  )


def _topic_component(value, maximum_length=48):
  component = re.sub(r'[^a-z0-9_-]+', '-', str(value).lower()).strip('-_')
  return (component or 'user')[:maximum_length]


def _notification_topic_name(config, user):
  identity = '{}:{}'.format(config['cluster_scope_id'], user)
  suffix = hashlib.sha256(identity.encode('utf-8')).hexdigest()[:12]
  return 'slurm-{}-{}-{}'.format(
    _topic_component(config['cluster_name']),
    _topic_component(user),
    suffix,
  )


def _run_oci(config, arguments):
  command = ['oci'] + arguments + [
    '--auth', config['auth'],
    '--region', config['region'],
  ]
  try:
    return subprocess.run(
      command,
      check=True,
      stdout=subprocess.PIPE,
      stderr=subprocess.PIPE,
      universal_newlines=True,
      timeout=120,
    )
  except FileNotFoundError as error:
    raise NotificationError('OCI CLI executable was not found') from error
  except subprocess.CalledProcessError as error:
    detail = (error.stderr or error.stdout or '').strip()
    if detail:
      raise NotificationError('OCI CLI failed: {}'.format(detail)) from error
    raise NotificationError(
      'OCI CLI failed with exit status {}'.format(error.returncode)
    ) from error
  except subprocess.TimeoutExpired as error:
    raise NotificationError('OCI CLI timed out after 120 seconds') from error
  except OSError as error:
    raise NotificationError('Unable to execute OCI CLI: {}'.format(error)) from error


def _notification_identifier_spec(resource_name):
  specs = {
    # NotificationTopic uses topic_id in the SDK, which the OCI CLI renders as
    # topic-id.  Keep this strict so another OCID-shaped field cannot be
    # mistaken for the Topic identifier.
    'topic': (('topic-id',), 'ocid1.onstopic.'),
    'subscription': (('id',), 'ocid1.onssubscription.'),
  }
  try:
    return specs[resource_name]
  except KeyError as error:
    raise NotificationError(
      "Unsupported notification resource type '{}'".format(resource_name)
    ) from error


def _notification_identifier_from_data(data, resource_name):
  identifier_keys, identifier_prefix = _notification_identifier_spec(
    resource_name
  )
  if not isinstance(data, dict):
    return None
  identifiers = {
    data.get(key) for key in identifier_keys
    if isinstance(data.get(key), str)
    and data.get(key).startswith(identifier_prefix)
  }
  if len(identifiers) != 1:
    return None
  return identifiers.pop()


def _oci_identifier(result, resource_name):
  try:
    payload = json.loads(result.stdout or '')
    data = payload.get('data')
    identifier = _notification_identifier_from_data(data, resource_name)
  except (AttributeError, TypeError, ValueError) as error:
    raise NotificationError(
      'OCI CLI did not return a valid {} OCID'.format(resource_name)
    ) from error
  if identifier is None:
    raise NotificationError(
      'OCI CLI did not return a valid {} OCID'.format(resource_name)
    )
  return identifier


def _delete_error_may_mean_absent(error):
  detail = str(error).lower()
  return 'notauthorizedornotfound' in detail or re.search(
    r'(^|[^0-9])404([^0-9]|$)', detail
  ) is not None


def _notification_resource_is_absent(config, resource_type, resource_id):
  """Confirm absence through an authorized compartment list operation."""
  _, identifier_prefix = _notification_identifier_spec(
    resource_type
  )
  result = _run_oci(config, [
    'ons', resource_type, 'list',
    '--compartment-id', config['compartment_id'],
    '--all',
    '--output', 'json',
    '--query', '@',
  ])
  output = (result.stdout or '').strip()
  if not output:
    resources = []
  else:
    try:
      payload = json.loads(output)
      resources = payload.get('data')
    except (AttributeError, TypeError, ValueError) as error:
      raise NotificationError(
        'OCI CLI returned invalid {} list output'.format(resource_type)
      ) from error
    if not isinstance(resources, list):
      raise NotificationError(
        'OCI CLI returned invalid {} list output'.format(resource_type)
      )
  if (
    not isinstance(resource_id, str)
    or not resource_id.startswith(identifier_prefix)
  ):
    raise NotificationError(
      'Invalid {} OCID for absence verification'.format(resource_type)
    )
  listed_ids = []
  for resource in resources:
    listed_id = _notification_identifier_from_data(resource, resource_type)
    if listed_id is None:
      raise NotificationError(
        'OCI CLI returned invalid {} list output'.format(resource_type)
      )
    listed_ids.append(listed_id)
  return resource_id not in listed_ids


def _find_owned_notification_topic(config, topic_name, expected_tags):
  """Find one unregistered Topic created by this exact provisioning attempt."""
  topics = []
  for attempt in range(3):
    result = _run_oci(config, [
      'ons', 'topic', 'list',
      '--compartment-id', config['compartment_id'],
      '--name', topic_name,
      '--all',
      '--output', 'json',
      '--query', '@',
    ])
    output = (result.stdout or '').strip()
    if not output:
      # OCI CLI emits no JSON for a successfully listed empty collection.
      topics = []
    else:
      try:
        payload = json.loads(output)
        topics = payload.get('data')
      except (AttributeError, TypeError, ValueError) as error:
        raise NotificationError(
          'OCI CLI returned invalid topic list output during cleanup'
        ) from error
      if not isinstance(topics, list):
        raise NotificationError(
          'OCI CLI returned invalid topic list output during cleanup'
        )
    if topics or attempt == 2:
      break
    time.sleep(1)

  registry = _load_notification_registry()
  referenced_topic_ids = set()
  for entry in registry.get('users', {}).values():
    if not isinstance(entry, dict):
      raise NotificationError('Invalid notification registry user entry')
    referenced_topic_id = entry.get('topic_id')
    if referenced_topic_id:
      if not isinstance(referenced_topic_id, str):
        raise NotificationError('Invalid Topic OCID in notification registry')
      referenced_topic_ids.add(referenced_topic_id)

  pending_cleanup = registry.get('config', {}).get('pending_cleanup', [])
  if not isinstance(pending_cleanup, list):
    raise NotificationError(
      "Notification registry field 'pending_cleanup' must be a list"
    )
  for entry in pending_cleanup:
    if not isinstance(entry, dict):
      raise NotificationError('Invalid pending notification cleanup entry')
    referenced_topic_id = entry.get('topic_id')
    if referenced_topic_id:
      if not isinstance(referenced_topic_id, str):
        raise NotificationError(
          'Invalid Topic OCID in pending notification cleanup'
        )
      referenced_topic_ids.add(referenced_topic_id)

  matches = []
  for topic in topics:
    if not isinstance(topic, dict) or topic.get('name') != topic_name:
      continue
    if topic.get('compartment-id') != config['compartment_id']:
      continue
    if topic.get('lifecycle-state') not in ('ACTIVE', 'CREATING'):
      continue
    tags = topic.get('freeform-tags')
    if not isinstance(tags, dict) or any(
      tags.get(key) != value for key, value in expected_tags.items()
    ):
      continue
    topic_id = _notification_identifier_from_data(topic, 'topic')
    if topic_id is not None and topic_id not in referenced_topic_ids:
      matches.append(topic_id)

  if len(matches) != 1:
    raise NotificationError(
      'Expected exactly one owned Topic for cleanup, found {}'.format(
        len(matches)
      )
    )
  return matches[0]


def _cleanup_topic_after_uncertain_creation(
  config, user, email, topic_name, expected_tags
):
  """Delete a Topic only when this exact create attempt can be identified."""
  cleanup_errors = []
  try:
    recovered_topic_id = _find_owned_notification_topic(
      config, topic_name, expected_tags
    )
    cleanup_errors, remaining = _delete_notification_resources(
      config,
      {
        'topic_id': recovered_topic_id,
        'managed_by': 'cluster-cli',
        'email': email,
      },
    )
    if cleanup_errors:
      try:
        _record_pending_cleanup(user, remaining, cleanup_errors)
      except NotificationError as record_error:
        cleanup_errors.append(
          'could not record pending cleanup: {}'.format(record_error)
        )
  except NotificationError as recovery_error:
    cleanup_errors.append(
      'could not identify created Topic for cleanup: {}'.format(
        recovery_error
      )
    )
  return cleanup_errors


def _delete_notification_resources(config, entry):
  """Best-effort delete. Return errors and the identifiers still needing cleanup."""
  errors = []
  remaining = dict(entry)
  subscription_id = entry.get('subscription_id')
  topic_id = entry.get('topic_id')

  if subscription_id:
    try:
      _run_oci(config, [
        'ons', 'subscription', 'delete',
        '--subscription-id', subscription_id,
        '--force',
      ])
      remaining.pop('subscription_id', None)
    except NotificationError as error:
      absent = False
      verification_error = None
      if _delete_error_may_mean_absent(error):
        try:
          absent = _notification_resource_is_absent(
            config, 'subscription', subscription_id
          )
        except NotificationError as caught_error:
          verification_error = caught_error
      if absent:
        remaining.pop('subscription_id', None)
      else:
        detail = 'subscription {}: {}'.format(subscription_id, error)
        if verification_error is not None:
          detail += '; absence verification failed: {}'.format(
            verification_error
          )
        errors.append(detail)

  if topic_id:
    try:
      _run_oci(config, [
        'ons', 'topic', 'delete',
        '--topic-id', topic_id,
        '--force',
      ])
      remaining.pop('topic_id', None)
    except NotificationError as error:
      absent = False
      verification_error = None
      if _delete_error_may_mean_absent(error):
        try:
          absent = _notification_resource_is_absent(
            config, 'topic', topic_id
          )
        except NotificationError as caught_error:
          verification_error = caught_error
      if absent:
        remaining.pop('topic_id', None)
      else:
        detail = 'topic {}: {}'.format(topic_id, error)
        if verification_error is not None:
          detail += '; absence verification failed: {}'.format(
            verification_error
          )
        errors.append(detail)

  return errors, remaining


def _record_pending_cleanup(user, entry, errors):
  if not entry.get('topic_id') and not entry.get('subscription_id'):
    return

  def record(registry):
    config = registry.setdefault('config', {})
    pending = config.setdefault('pending_cleanup', [])
    pending.append({
      'cleanup_id': str(uuid.uuid4()),
      'username': user,
      'email': entry.get('email', ''),
      'topic_id': entry.get('topic_id', ''),
      'subscription_id': entry.get('subscription_id', ''),
      'managed_by': 'cluster-cli',
      'errors': errors,
      'recorded_at': datetime.datetime.now(
        datetime.timezone.utc
      ).isoformat(),
    })

  _update_notification_registry(record)


def _prepare_pending_cleanup():
  """Validate the cleanup journal and give every entry a stable identifier."""
  def prepare(registry):
    validated_config = _validated_notification_config(registry)
    config = registry.setdefault('config', {})
    pending = config.get('pending_cleanup', [])
    if not isinstance(pending, list):
      raise NotificationError(
        "Notification registry field 'pending_cleanup' must be a list"
      )

    snapshot = []
    cleanup_ids = set()
    for entry in pending:
      if not isinstance(entry, dict):
        raise NotificationError('Invalid pending notification cleanup entry')
      cleanup_id = entry.get('cleanup_id')
      if (
        not isinstance(cleanup_id, str)
        or not cleanup_id
        or cleanup_id in cleanup_ids
      ):
        cleanup_id = str(uuid.uuid4())
        entry['cleanup_id'] = cleanup_id
      cleanup_ids.add(cleanup_id)
      snapshot.append(dict(entry))
    return validated_config, snapshot

  return _update_notification_registry(prepare)


def _commit_pending_cleanup_results(results):
  """Atomically remove or replace journal entries by their stable identifier."""
  def commit(registry):
    config = registry.setdefault('config', {})
    pending = config.get('pending_cleanup', [])
    if not isinstance(pending, list):
      raise NotificationError(
        "Notification registry field 'pending_cleanup' must be a list"
      )

    matched = set()
    updated = []
    for entry in pending:
      if not isinstance(entry, dict):
        raise NotificationError('Invalid pending notification cleanup entry')
      cleanup_id = entry.get('cleanup_id')
      if cleanup_id not in results:
        updated.append(entry)
        continue
      matched.add(cleanup_id)
      replacement = results[cleanup_id]
      if replacement is not None:
        updated.append(replacement)

    missing = set(results) - matched
    if missing:
      raise NotificationError(
        'Notification cleanup journal changed while cleanup was running'
      )
    if updated:
      config['pending_cleanup'] = updated
    else:
      config.pop('pending_cleanup', None)

  _update_notification_registry(commit)


def _create_notification_resources(config, user, email):
  provision_id = str(uuid.uuid4())
  tags = {
    'cluster_name': config['cluster_name'],
    'parent_cluster': config['cluster_name'],
    'notification_scope': config['cluster_scope_id'],
    'notification_provision_id': provision_id,
    'slurm_user': user,
    'managed_by': 'cluster-cli',
  }
  serialized_tags = json.dumps(tags, separators=(',', ':'), sort_keys=True)
  topic_name = _notification_topic_name(config, user)
  topic_id = None
  try:
    try:
      topic_result = _run_oci(config, [
        'ons', 'topic', 'create',
        '--compartment-id', config['compartment_id'],
        '--name', topic_name,
        '--description', 'Slurm job notifications for {}'.format(user),
        '--freeform-tags', serialized_tags,
        '--output', 'json',
        '--query', '@',
      ])
    except NotificationError as create_error:
      # A timeout is ambiguous: the service may have created the Topic even
      # though the CLI could not return its response.  Other CLI/API errors do
      # not justify a cleanup search because no create success is implied.
      if not isinstance(create_error.__cause__, subprocess.TimeoutExpired):
        raise
      topic_error = create_error
    else:
      try:
        topic_id = _oci_identifier(topic_result, 'topic')
      except NotificationError as identifier_error:
        topic_error = identifier_error
      else:
        topic_error = None

    if topic_error is not None:
      cleanup_errors = _cleanup_topic_after_uncertain_creation(
        config, user, email, topic_name, tags
      )
      if cleanup_errors:
        raise NotificationError(
          '{}; cleanup also failed: {}'.format(
            topic_error, '; '.join(cleanup_errors)
          )
        ) from topic_error
      raise topic_error

    subscription_result = _run_oci(config, [
      'ons', 'subscription', 'create',
      '--compartment-id', config['compartment_id'],
      '--topic-id', topic_id,
      '--protocol', 'EMAIL',
      '--subscription-endpoint', email,
      '--freeform-tags', serialized_tags,
      '--output', 'json',
      '--query', '@',
    ])
    subscription_id = _oci_identifier(subscription_result, 'subscription')
    return {
      'email': email,
      'topic_id': topic_id,
      'subscription_id': subscription_id,
      'managed_by': 'cluster-cli',
    }
  except NotificationError as error:
    if topic_id:
      cleanup_errors, remaining = _delete_notification_resources(
        config,
        {'topic_id': topic_id, 'managed_by': 'cluster-cli', 'email': email},
      )
      if cleanup_errors:
        try:
          _record_pending_cleanup(user, remaining, cleanup_errors)
        except NotificationError as record_error:
          cleanup_errors.append(
            'could not record pending cleanup: {}'.format(record_error)
          )
        raise NotificationError(
          '{}; cleanup also failed: {}'.format(error, '; '.join(cleanup_errors))
        ) from error
    raise


def _store_user_routing(user, entry):
  def store(registry):
    users = registry.setdefault('users', {})
    existing = users.get(user)
    if existing is not None:
      raise NotificationError(
        "Notification routing already exists for user '{}'".format(user)
      )
    users[user] = dict(entry)
    _mark_backup_sync_pending(
      registry, "notification routing for '{}' was added".format(user)
    )

  _update_notification_registry(store)


def _remove_user_routing(user):
  def remove(registry):
    users = registry.setdefault('users', {})
    entry = users.get(user)
    if entry and entry.get('managed_by') == 'terraform':
      raise NotificationError(
        "User '{}' is managed by Terraform and cannot be deleted by cluster".format(
          user
        )
      )
    config = dict(registry.get('config', {}))
    if entry is not None:
      del users[user]
      entry = dict(entry)
      _mark_backup_sync_pending(
        registry, "notification routing for '{}' was removed".format(user)
      )
    return config, entry

  return _update_notification_registry(remove)


def _restore_user_routing(user, entry):
  if entry is None:
    return

  def restore(registry):
    users = registry.setdefault('users', {})
    if user in users:
      raise NotificationError(
        "Cannot restore notification routing for '{}': entry already exists".format(
          user
        )
      )
    users[user] = dict(entry)
    _mark_backup_sync_pending(
      registry, "notification routing for '{}' was restored".format(user)
    )

  _update_notification_registry(restore)


def _find_slurm_backup(path=None):
  """Return (host, user) from the first [slurm_backup] inventory entry."""
  if path is None:
    path = ansible_inventory_path
  try:
    with open(path, 'r') as inventory_file:
      section = None
      for raw_line in inventory_file:
        line = raw_line.strip()
        if not line or line.startswith(('#', ';')):
          continue
        if line.startswith('[') and line.endswith(']'):
          section = line[1:-1].strip()
          continue
        if section != 'slurm_backup':
          continue

        try:
          fields = shlex.split(line, comments=True)
        except ValueError as error:
          raise NotificationError(
            'Invalid [slurm_backup] inventory entry: {}'.format(error)
          ) from error
        if not fields:
          continue
        variables = {}
        for field in fields[1:]:
          if '=' in field:
            key, value = field.split('=', 1)
            variables[key] = value
        host_value = variables.get('ansible_host', fields[0])
        user_value = variables.get(
          'ansible_user', pwd.getpwuid(os.geteuid()).pw_name
        )
        if (
          not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._:-]*', host_value)
          or not re.fullmatch(r'[A-Za-z_][A-Za-z0-9._-]*', user_value)
        ):
          raise NotificationError(
            'Unsafe host or user in [slurm_backup] inventory entry'
          )
        return host_value, user_value
  except FileNotFoundError as error:
    raise NotificationError(
      'Ansible inventory {} was not found'.format(path)
    ) from error
  except OSError as error:
    raise NotificationError(
      'Unable to read Ansible inventory {}: {}'.format(path, error)
    ) from error
  return None


def _encode_backup_snapshot(registry):
  config = _validated_notification_config(registry)
  users = registry.get('users', {})
  if not isinstance(users, dict):
    raise NotificationError("Notification registry field 'users' is invalid")
  payload = json.dumps(
    {
      'version': 1,
      'cluster_scope_id': config['cluster_scope_id'],
      'users': users,
    },
    separators=(',', ':'),
    sort_keys=True,
  ).encode('utf-8')
  encoded_payload = base64.urlsafe_b64encode(payload).decode('ascii')
  _decode_backup_snapshot(encoded_payload)
  return encoded_payload


def _decode_backup_snapshot(encoded_payload):
  if not isinstance(encoded_payload, str) or len(encoded_payload) > 1024 * 1024:
    raise NotificationError('Invalid backup registry synchronization payload')
  try:
    payload_bytes = base64.b64decode(
      encoded_payload.encode('ascii'), altchars=b'-_', validate=True
    )
    payload = json.loads(payload_bytes.decode('utf-8'))
  except (ValueError, UnicodeError, json.JSONDecodeError) as error:
    raise NotificationError(
      'Invalid backup registry synchronization payload'
    ) from error
  if (
    not isinstance(payload, dict)
    or payload.get('version') != 1
    or not isinstance(payload.get('cluster_scope_id'), str)
    or not payload.get('cluster_scope_id')
    or not isinstance(payload.get('users'), dict)
  ):
    raise NotificationError('Invalid backup registry synchronization payload')
  for username, entry in payload['users'].items():
    if not isinstance(username, str) or not isinstance(entry, dict):
      raise NotificationError('Invalid user in backup registry snapshot')
    required = ('email', 'topic_id', 'subscription_id', 'managed_by')
    if any(
      not isinstance(entry.get(field), str) or not entry.get(field)
      for field in required
    ):
      raise NotificationError(
        "Invalid notification routing for user '{}'".format(username)
      )
  return payload


def _run_backup_sync(backup, encoded_payload):
  host_value, user_value = backup
  if ':' in host_value:
    host_value = '[{}]'.format(host_value)
  target = '{}@{}'.format(user_value, host_value)
  command = [
    'ssh',
    '-o', 'BatchMode=yes',
    '-o', 'ConnectTimeout=10',
    '-o', 'StrictHostKeyChecking=no',
    '-i', os.path.expanduser(cluster_ssh_key_path),
    target,
    '/usr/bin/python3',
    '-',
    notification_registry_path,
  ]
  helper_input = 'encoded_payload = {!r}\n{}'.format(
    encoded_payload, backup_sync_helper_source
  )
  try:
    subprocess.run(
      command,
      check=True,
      stdout=subprocess.PIPE,
      stderr=subprocess.PIPE,
      universal_newlines=True,
      timeout=30,
      input=helper_input,
    )
  except FileNotFoundError as error:
    raise NotificationError('SSH executable was not found') from error
  except subprocess.TimeoutExpired as error:
    raise NotificationError(
      'Backup controller registry synchronization timed out'
    ) from error
  except subprocess.CalledProcessError as error:
    detail = (error.stderr or error.stdout or '').strip()
    if detail:
      raise NotificationError(
        'Backup controller registry synchronization failed: {}'.format(detail)
      ) from error
    raise NotificationError(
      'Backup controller registry synchronization failed with exit status {}'.format(
        error.returncode
      )
    ) from error
  except OSError as error:
    raise NotificationError(
      'Unable to synchronize the backup controller registry: {}'.format(error)
    ) from error


def _sync_backup_registry(registry=None):
  backup = _find_slurm_backup()
  if backup is None:
    if os.path.exists(notification_registry_path):
      current_registry = _load_notification_registry()
      pending_sync = current_registry.get('config', {}).get(
        'pending_backup_sync'
      )
      if pending_sync is not None:
        _clear_pending_backup_sync(pending_sync)
    return False
  sync_lock_path = notification_registry_path + '.sync.lock'
  try:
    os.makedirs(os.path.dirname(notification_registry_path), exist_ok=True)
    with open(sync_lock_path, 'a+') as sync_lock:
      fcntl.flock(sync_lock.fileno(), fcntl.LOCK_EX)
      # A caller may have captured its registry before another concurrent CLI
      # mutation completed.  Serialize remote writes and always prefer the
      # latest atomically-written local snapshot so an older snapshot cannot
      # overwrite a newer backup registry.
      if os.path.exists(notification_registry_path) or registry is None:
        registry = _load_notification_registry()
      pending_sync = registry.get('config', {}).get('pending_backup_sync')
      _run_backup_sync(backup, _encode_backup_snapshot(registry))
      if pending_sync is not None:
        _clear_pending_backup_sync(pending_sync)
    return True
  except NotificationError:
    raise
  except OSError as error:
    raise NotificationError(
      'Unable to lock backup controller registry synchronization: {}'.format(
        error
      )
    ) from error


def _mark_backup_sync_pending(registry, detail):
  config = registry.setdefault('config', {})
  config['pending_backup_sync'] = {
    'generation': str(uuid.uuid4()),
    'recorded_at': datetime.datetime.now(
      datetime.timezone.utc
    ).isoformat(),
    'error': str(detail),
  }


def _record_pending_backup_sync(error):
  def record(registry):
    _mark_backup_sync_pending(registry, error)

  _update_notification_registry(record)


def _clear_pending_backup_sync(expected_marker):
  def clear(registry):
    config = registry.setdefault('config', {})
    if config.get('pending_backup_sync') == expected_marker:
      config.pop('pending_backup_sync', None)

  _update_notification_registry(clear)

def exists(key, value):
    try:
        if key == 'uid':
            return pwd.getpwuid(int(value)).pw_uid
        elif key == 'username':
            return pwd.getpwnam(value).pw_uid
        elif key == 'gid':
            return grp.getgrgid(int(value)).gr_gid
        elif key == 'groupname':
            return grp.getgrnam(value).gr_gid

    except KeyError:
        return False

def find_next_gid(): 
  base_gid = 10005
  search_base = groups_dn
  search_filter = '(gidNumber=*)'
  attrs = ['*']

  server = ldap3.Server(host, use_ssl=True)
  with ldap3.Connection(server, bind_dn, bind_pass, auto_bind=True) as conn:
    conn.search(search_base, search_filter, attributes=attrs)
    for entry in conn.entries:
      if int(entry.gidNumber.raw_values[0]) > base_gid: 
        base_gid = int(entry.gidNumber.raw_values[0])

    return base_gid + 1
     
def find_next_uid(): 
