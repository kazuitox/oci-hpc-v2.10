@notification.command(name='sync')
def sync_notification_registry():
  """Synchronize notification routing to the backup Slurm controller."""
  try:
    registry = _load_notification_registry()
    if not _notifications_enabled(registry):
      click.echo('Slurm job notifications are disabled')
      return
    synchronized = _sync_backup_registry(registry)
    if not synchronized:
      click.echo('No Slurm backup controller is configured')
      return
    click.echo('Notification registry synchronized to the backup controller')
  except NotificationError as error:
    try:
      _record_pending_backup_sync(error)
    except NotificationError:
      pass
    raise click.ClickException(str(error)) from error


@notification.command(name='cleanup')
def cleanup_notification_resources():
  """Retry deletion of OCI resources recorded in the cleanup journal."""
  try:
    config, pending = _prepare_pending_cleanup()
  except NotificationError as error:
    raise click.ClickException(str(error)) from error

  if not pending:
    click.echo('No pending notification cleanup')
    return

  results = {}
  failure_details = []
  for entry in pending:
    cleanup_id = entry['cleanup_id']
    errors, remaining = _delete_notification_resources(config, entry)
    if errors:
      remaining['cleanup_id'] = cleanup_id
      remaining['errors'] = list(errors)
      remaining['last_attempted_at'] = datetime.datetime.now(
        datetime.timezone.utc
      ).isoformat()
      results[cleanup_id] = remaining
      failure_details.append('{}: {}'.format(
        entry.get('username', 'unknown'), '; '.join(errors)
      ))
    else:
      results[cleanup_id] = None

  try:
    _commit_pending_cleanup_results(results)
  except NotificationError as error:
    raise click.ClickException(str(error)) from error

  backup_sync_error = None
  try:
    _sync_backup_registry(_load_notification_registry())
  except NotificationError as error:
    backup_sync_error = error
    try:
      _record_pending_backup_sync(error)
    except NotificationError as record_error:
      backup_sync_error = NotificationError(
        '{}; unable to record pending synchronization: {}'.format(
          error, record_error
        )
      )

  completed = len(pending) - len(failure_details)
  if failure_details or backup_sync_error is not None:
    message = 'Notification cleanup removed {} of {} journal entries'.format(
      completed, len(pending)
    )
    if failure_details:
      message += '; cleanup still pending: {}'.format(
        '; '.join(failure_details)
      )
    if backup_sync_error is not None:
      message += '; backup synchronization is pending: {}'.format(
        backup_sync_error
      )
    raise click.ClickException(message)

  click.echo('Notification cleanup removed {} journal entries'.format(completed))


