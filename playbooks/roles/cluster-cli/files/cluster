def _ensure_ldap_success(connection, succeeded, action):
  result = getattr(connection, 'result', {}) or {}
  result_code = result.get('result', 0)
  if succeeded is False or result_code != 0:
    detail = result.get('message') or result.get('description') or str(result)
    raise NotificationError('{} failed: {}'.format(action, detail))


def _create_ldap_user(user, password, uid, gid, name, email=None):
  attributes = {
    'sn': user,
    'uid': user,
    'uidNumber': uid,
    'gidNumber': gid,
    'userPassword': password,
    'gecos': name,
    'homeDirectory': '/home/{}'.format(user),
    'displayName': name,
    'loginShell': '/bin/bash',
  }
  if email:
    attributes['mail'] = email

  group_required = exists('gid', gid) is False
  user_created = False
  group_created = False
  server = ldap3.Server(host, use_ssl=True)
  with ldap3.Connection(server, bind_dn, bind_pass, auto_bind=True) as conn:
    try:
      added = conn.add(
        'cn={},{}'.format(user, people_dn),
        ['inetOrgPerson', 'posixAccount', 'top', 'shadowAccount'],
        attributes,
      )
      _ensure_ldap_success(conn, added, "LDAP user '{}' creation".format(user))
      user_created = True

      if group_required:
        click.echo('Creating group')
        group_added = conn.add(
          'cn={},{}'.format(user, groups_dn),
          ['top', 'groupOfMembers', 'posixgroup'],
          {'cn': [user], 'gidNumber': [gid]},
        )
        _ensure_ldap_success(
          conn,
          group_added,
          "LDAP group '{}' creation".format(user),
        )
        group_created = True
    except Exception:
      if group_created:
        conn.delete('cn={},{}'.format(user, groups_dn))
      if user_created:
        conn.delete('cn={},{}'.format(user, people_dn))
      raise
  return group_created


def _delete_ldap_user(user):
  server = ldap3.Server(host, use_ssl=True)
  with ldap3.Connection(server, bind_dn, bind_pass, auto_bind=True) as conn:
    deleted = conn.delete('cn={},{}'.format(user, people_dn))
    _ensure_ldap_success(conn, deleted, "LDAP user '{}' deletion".format(user))


def _rollback_ldap_user(user, group_created=False):
  errors = []
  try:
    server = ldap3.Server(host, use_ssl=True)
    with ldap3.Connection(server, bind_dn, bind_pass, auto_bind=True) as conn:
      if group_created:
        try:
          conn.delete('cn={},{}'.format(user, groups_dn))
        except Exception as error:
          errors.append("LDAP group '{}': {}".format(user, error))
      try:
        conn.delete('cn={},{}'.format(user, people_dn))
      except Exception as error:
        errors.append("LDAP user '{}': {}".format(user, error))
  except Exception as error:
    errors.append("LDAP rollback connection for '{}': {}".format(user, error))
  return errors


def _initialize_user_home(user, nossh):
  home_directory = '/home/{}/'.format(user)
  subprocess.run(
    ['sudo', 'su', '-', user, '-c', 'ls'],
    check=False,
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL,
  )

  if not nossh:
    private_key = os.path.join(home_directory, '.ssh', 'id_rsa')
    public_key = private_key + '.pub'
    authorized_keys = os.path.join(home_directory, '.ssh', 'authorized_keys')
    subprocess.run(
      [
        'sudo', '-u', user,
        'ssh-keygen', '-t', 'rsa', '-b', '2048', '-q',
        '-f', private_key, '-N', '',
      ],
      check=False,
      stderr=subprocess.DEVNULL,
    )
    subprocess.run(
      ['sudo', '-u', user, 'mv', public_key, authorized_keys],
      check=False,
      stderr=subprocess.DEVNULL,
    )
     
