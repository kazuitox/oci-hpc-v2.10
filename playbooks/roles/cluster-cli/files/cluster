@user.command()
@click.argument('user')
@click.option('-p', '--password', prompt='Password', required=True, hide_input=True,
              confirmation_prompt=True)
@click.option('-n', '--name', prompt='Full Name', required=True)
@click.option('-i', '--uid', default=None, help='Select the userID')
@click.option('-g', '--gid', default="9876", help='Add to this groupID')
@click.option('-e', '--email', default=None, help='Email address for Slurm job notifications')
@click.option('-nossh', '--nossh', is_flag=True, default=False, help='Flag to not generate a user-specific ssh-key pair for passwordless ssh.')
def add(user, password, uid, gid, name, email, nossh):
  """ add user """
  try:
    registry = _load_notification_registry()
  except NotificationError as error:
    raise click.ClickException(str(error)) from error

  notifications_enabled = _notifications_enabled(registry)
  config = None
  if notifications_enabled:
    try:
      config = _validated_notification_config(registry)
    except NotificationError as error:
      raise click.ClickException(str(error)) from error
    if email is None:
      email = click.prompt('Email address', type=str)

  if email is not None:
    email = email.strip()
    if not _validate_email(email):
      raise click.BadParameter(
        'must be a valid email address',
        param_hint='--email',
      )

  if uid is None: 
    uid = find_next_uid()
  if gid is None: 
    gid = find_next_gid()

  routing_entry = None
  if notifications_enabled:
    if user in registry.get('users', {}):
      raise click.ClickException(
        "Notification routing already exists for user '{}'".format(user)
      )
    try:
      routing_entry = _create_notification_resources(config, user, email)
    except NotificationError as error:
      raise click.ClickException(
        'Unable to create OCI notification resources: {}'.format(error)
      ) from error

  try:
    group_created = _create_ldap_user(
      user, password, uid, gid, name, email=email
    )
  except Exception as error:
    cleanup_errors = []
    if routing_entry is not None:
      cleanup_errors, remaining = _delete_notification_resources(
        config, routing_entry
      )
      if cleanup_errors:
        try:
          _record_pending_cleanup(user, remaining, cleanup_errors)
        except NotificationError as record_error:
          cleanup_errors.append(
            'could not record pending cleanup: {}'.format(record_error)
          )
    message = "Unable to create LDAP user '{}': {}".format(user, error)
    if cleanup_errors:
      message += '; OCI cleanup failed: {}'.format('; '.join(cleanup_errors))
    raise click.ClickException(message) from error

  if routing_entry is not None:
    try:
      _store_user_routing(user, routing_entry)
    except NotificationError as error:
      rollback_errors = _rollback_ldap_user(user, group_created)
      cleanup_errors, remaining = _delete_notification_resources(
        config, routing_entry
      )
      if cleanup_errors:
        try:
          _record_pending_cleanup(user, remaining, cleanup_errors)
        except NotificationError as record_error:
          cleanup_errors.append(
            'could not record pending cleanup: {}'.format(record_error)
          )
      details = rollback_errors + cleanup_errors
      message = 'Unable to store notification routing: {}'.format(error)
      if details:
        message += '; rollback issues: {}'.format('; '.join(details))
      raise click.ClickException(message) from error

  backup_sync_error = None
  if routing_entry is not None:
    try:
      current_registry = _load_notification_registry()
      _sync_backup_registry(current_registry)
    except NotificationError as error:
      backup_sync_error = error
      try:
        _record_pending_backup_sync(error)
      except NotificationError as record_error:
        backup_sync_error = NotificationError(
          '{}; unable to record pending synchronization: {}'.format(
            error, record_error
          )
        )

  _initialize_user_home(user, nossh)
  if routing_entry is not None:
    click.echo(
      'Notification subscription created for {}. '
      'The recipient must confirm the OCI Notifications email.'.format(email)
    )
  if backup_sync_error is not None:
    raise click.ClickException(
      "LDAP user '{}' and its local notification routing were created, but "
      'backup controller synchronization is pending: {}'.format(
        user, backup_sync_error
      )
    )


@user.command()
@click.argument('user')
def delete(user):
  """ delete user """
  if user == 'opc':
    raise click.ClickException(
      "User 'opc' is locally/Terraform managed and cannot be deleted by cluster"
    )

  try:
    registry = _load_notification_registry()
  except NotificationError as error:
    raise click.ClickException(str(error)) from error

  routing_entry = registry.get('users', {}).get(user)
  config = dict(registry.get('config', {}))
  if routing_entry and routing_entry.get('managed_by') == 'terraform':
    raise click.ClickException(
      "User '{}' is managed by Terraform and cannot be deleted by cluster".format(
        user
      )
    )

  if routing_entry is not None:
    try:
      config = _validated_notification_config(registry)
      config, routing_entry = _remove_user_routing(user)
    except NotificationError as error:
      raise click.ClickException(str(error)) from error

    try:
      _sync_backup_registry(_load_notification_registry())
    except NotificationError as error:
      restore_errors = []
      try:
        _restore_user_routing(user, routing_entry)
      except NotificationError as restore_error:
        restore_errors.append(str(restore_error))
      try:
        _sync_backup_registry(_load_notification_registry())
      except NotificationError as restore_sync_error:
        restore_errors.append(str(restore_sync_error))
        try:
          _record_pending_backup_sync(restore_sync_error)
        except NotificationError as record_error:
          restore_errors.append(
            'unable to record pending synchronization: {}'.format(record_error)
          )
      message = (
        'Backup controller synchronization failed; LDAP user and OCI '
        'resources were not deleted: {}'.format(error)
      )
      if restore_errors:
        message += '; restore issues: {}'.format('; '.join(restore_errors))
      raise click.ClickException(message) from error

  try:
    _delete_ldap_user(user)
  except Exception as error:
    restore_error = None
    if routing_entry is not None:
      try:
        _restore_user_routing(user, routing_entry)
      except NotificationError as caught_error:
        restore_error = caught_error
      try:
        _sync_backup_registry(_load_notification_registry())
      except NotificationError as caught_error:
        try:
          _record_pending_backup_sync(caught_error)
        except NotificationError:
          pass
        if restore_error is None:
          restore_error = caught_error
    message = "Unable to delete LDAP user '{}': {}".format(user, error)
    if restore_error is not None:
      message += '; notification routing restore failed: {}'.format(
        restore_error
      )
    raise click.ClickException(message) from error

  if routing_entry is not None:
    cleanup_errors, remaining = _delete_notification_resources(
      config, routing_entry
    )
    if cleanup_errors:
      try:
        _record_pending_cleanup(user, remaining, cleanup_errors)
      except NotificationError as record_error:
        cleanup_errors.append(
          'could not record pending cleanup: {}'.format(record_error)
        )
      raise click.ClickException(
        "LDAP user '{}' was deleted, but OCI cleanup is pending: {}".format(
          user, '; '.join(cleanup_errors)
        )
      )

  
  
main.add_command(group)
main.add_command(user)
main.add_command(notification)

if __name__ == "__main__":
  main()
