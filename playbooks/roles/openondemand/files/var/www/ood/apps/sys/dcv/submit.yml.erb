---
batch_connect:
  template: basic
  password_size: 48
  conn_params:
    - session_id
    - auth_token
    - dcv_desktop
    - dcv_resolution
    - dcv_gl
    - dcv_max_clients
  script_wrapper: |
    trap 'clean_up 143' TERM INT HUP
    %s

cluster: "myslurm"

script:
  native:
    - "--partition=dcv"
    - "--nodes=1"
    - "--ntasks=1"
{% if ood_desktop_use_gpu | default(false) | bool %}
    - "--gres=gpu:A10:1"
{% endif %}
    - "--cpus-per-task={{ ood_dcv_cpus_per_task }}"
    - "--job-name=ood-dcv"
